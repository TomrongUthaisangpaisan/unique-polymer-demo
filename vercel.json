{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about",
      "destination": "/about/our-story/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(fonts|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}